# dnsmasq configuration for PXE boot server
# Generated by Terraform - Do not edit manually

# Use alternate configuration directory
conf-dir=/usr/local/etc/dnsmasq.d/,*.conf

# Specify interface
interface=${interface}

# Listen only on localhost and specified interface
listen-address=127.0.0.1,${pxe_server_ip}

# Disable DNS functionality (if needed, enable and configure)
# port=53

# Enable DHCP logging
log-dhcp
log-facility=/var/log/dnsmasq.log

# DHCP Configuration
dhcp-range=${interface},${dhcp_range_start},${dhcp_range_end},${subnet_mask},${dhcp_lease_time}s

# DHCP options
dhcp-option=option:router,${gateway}
dhcp-option=option:dns-server,${join(",", dns_servers)}
dhcp-option=option:domain-name,local
dhcp-option=option:domain-search,local

# PXE boot configuration
dhcp-boot=pxelinux.0,${pxe_server_ip}
dhcp-match=set:bios,option:client-arch,0
dhcp-boot=tag:bios,pxelinux.0,${pxe_server_ip}

# UEFI boot configuration
dhcp-match=set:efi,option:client-arch,7
dhcp-match=set:efi,option:client-arch,9
dhcp-boot=tag:efi,bootx64.efi,${pxe_server_ip}

# TFTP Configuration
enable-tftp
tftp-root=${pxe_root_path}
tftp-port=69

# TFTP options
tftp-secure
tftp-no-blocksize

# Performance tuning
cache-size=5000
neg-ttl=3600

# Logging
log-queries=extra
log-async=50

# Advanced features
# Enable additional logging for debugging
# log-facility=/var/log/dnsmasq-debug.log

# DHCP lease file location
dhcp-leasefile=/var/lib/dnsmasq/dnsmasq.leases

# PID file
pid-file=/var/run/dnsmasq.pid

# User and group for dnsmasq
# These may need adjustment for macOS
# user=dnsmasq
# group=dnsmasq
