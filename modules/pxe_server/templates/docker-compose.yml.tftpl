version: '3.8'

services:
  pxe-server:
    image: pxe-server:latest
    build:
      context: .
      dockerfile: Dockerfile
    container_name: talos-pxe-server
    
    # Network configuration
    network_mode: host
    
    # Port mappings
    ports:
      - "67:67/udp"    # DHCP
      - "69:69/udp"    # TFTP
      - "53:53/udp"    # DNS (optional)
    
    # Volume mounts
    volumes:
      - ${pxe_root_path}:/var/lib/tftp:ro
      - ${dnsmasq_config}:/config/dnsmasq.conf:ro
      - ${dhcp_hosts_config}:/config/dhcp-hosts.conf:ro
      - ./boot:/boot:ro
      - /var/lib/dnsmasq:/var/lib/dnsmasq
    
    # Resource limits
    deploy:
      resources:
        limits:
          cpus: '1'
          memory: 256M
        reservations:
          cpus: '0.5'
          memory: 128M
    
    # Environment
    environment:
      - PXE_ROOT=${pxe_root_path}
      - PXE_SERVER_IP=${pxe_server_ip}
      - CONTAINER_RUNTIME=${container_runtime}
    
    # Restart policy
    restart_policy:
      condition: unless-stopped
      delay: 5s
      max_attempts: 3
      window: 120s
    
    # Health check
    healthcheck:
      test: ["CMD", "dnsmasq", "--test"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    
    # Logging
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
        labels: "service=pxe-server"
    
    # Capabilities
    cap_add:
      - NET_ADMIN
      - NET_BIND_SERVICE
    
    # Security options
    security_opt:
      - no-new-privileges:true
    
    # User
    user: "root"

networks:
  default:
    name: pxe-network
    driver: bridge
