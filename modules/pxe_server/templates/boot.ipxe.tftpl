#!ipxe
# PXE Boot Script for Talos and Debian Linux Installation
# Generated by Terraform - Do not edit manually
# Talos: ${talos_version} | Debian: ${debian_version}

# Set variables
set server-ip ${pxe_server_ip}
set menu-timeout ${boot_menu_timeout}000

# Clear any residual settings
clear

:start
menu
item
item ========= TALOS LINUX (${talos_version}) =========
%{ if enable_talos ~}
item talos-boot Talos Linux - Boot
item talos-install Talos Linux - Install Configuration
%{ endif ~}
item
item ========= DEBIAN LINUX (${debian_version}) =========
%{ if enable_debian ~}
item debian-boot Debian Linux - Boot
item debian-install Debian Linux - Install
%{ endif ~}
item
item shell iPXE Shell
item exit Exit to BIOS
choose --timeout $${menu-timeout} target && goto $${target} || goto timeout

:timeout
echo Boot menu timeout reached - returning to start
sleep 2
goto start

%{ if enable_talos ~}
:talos-boot
echo Booting Talos Linux ${talos_version} (${talos_architecture})
echo Downloading kernel and initrd...
kernel http://$${server-ip}:8080/talos/vmlinuz-${talos_architecture} \
  ${talos_kernel_cmdline}
initrd http://$${server-ip}:8080/talos/initramfs-${talos_architecture}.xz
boot

:talos-install
echo Talos Linux ${talos_version} Installation
echo ============================================
echo
echo This will install Talos Linux with the following configuration:
echo Version: ${talos_version}
echo Architecture: ${talos_architecture}
echo
echo Press ENTER to continue or ESCAPE to go back
prompt --key 0x1b :start
echo Downloading Talos installer...
kernel http://$${server-ip}:8080/talos/vmlinuz-${talos_architecture} \
  ${talos_kernel_cmdline} \
  talos.platform=metal
initrd http://$${server-ip}:8080/talos/initramfs-${talos_architecture}.xz
boot

%{ endif ~}

%{ if enable_debian ~}
:debian-boot
echo Booting Debian Linux ${debian_version} (${debian_architecture})
echo Downloading kernel and initrd...
kernel http://$${server-ip}:8080/debian/linux \
  ${debian_kernel_cmdline} \
  auto=true \
  priority=critical
initrd http://$${server-ip}:8080/debian/initrd.gz
boot

:debian-install
echo Debian Linux ${debian_version} Installation
echo ============================================
echo
echo This will start the Debian installer with:
echo Version: ${debian_version}
echo Architecture: ${debian_architecture}
echo
echo Press ENTER to continue or ESCAPE to go back
prompt --key 0x1b :start
echo Downloading Debian installer...
kernel http://$${server-ip}:8080/debian/linux \
  ${debian_kernel_cmdline} \
  auto=true \
  locale=en_US \
  hostname=debian-new \
  domain=local \
  netcfg/get_hostname=debian \
  netcfg/get_domain=local \
  url=http://$${server-ip}:8080/debian/preseed.cfg
initrd http://$${server-ip}:8080/debian/initrd.gz
boot

%{ endif ~}

:shell
echo Enter iPXE shell (type 'exit' to return to menu)
shell
goto start

:exit
echo Exiting PXE boot menu
exit

:failed
echo Boot failed, entering shell
shell

